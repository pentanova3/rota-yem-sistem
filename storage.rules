rules_version = '2';
// Depolama (sözleşmeler, vergi levhaları): yalnızca giriş yapmış personel.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
