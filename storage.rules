rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Bayi/danışman evrakları — açık erişim (Firestore ile aynı model), 25MB sınır
    match /belgeler/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource == null || request.resource.size < 25 * 1024 * 1024;
    }
  }
}
